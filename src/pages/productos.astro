<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .page-heading {
    background: linear-gradient(135deg, #323946 0%, #1e2530 100%);
    padding: 40px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: #EFBD1A;
    border-radius: 2px;
  }

  .page-heading h1 {
    color: #fff;
    font-size: 26px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    position: relative;
  }

  .intro-section {
    padding: 60px 0;
  }

  .intro-grid {
    display: flex;
    gap: 50px;
    align-items: center;
  }

  .intro-image {
    flex: 0 0 470px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
