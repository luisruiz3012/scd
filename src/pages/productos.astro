<section class="security-section">
    <div class="container">
      <h2 class="section-title">seguridad y control acceso</h2>
      <p class="security-subtitle">Soluciones certificadas con más de 25 años de experiencia</p>
      <div class="security-grid">
        <div class="security-card">
          <div class="security-img-wrap">
            <a href="https://www.hikvision.com/es-la/"><img src="/images/Hikvision.png" alt="Cámaras HD" /></a>
          </div>
          <div class="security-body">
            <span class="security-brand">hikvision</span>
            <p class="security-desc">Cámaras HD 720 - 1080 HI-LOOK DVRS Y NVRS</p>
          </div>
        </div>
        <div class="security-card">
          <div class="security-img-wrap">
            <a href="https://www.anviz.com/"><img src="/images/ANVIZ.jpeg" alt="Controles de acceso" /></a>
          </div>
          <div class="security-body">
            <span class="security-brand">anviz</span>
            <p class="security-desc">Controles de acceso Huella, Facial, Iris, Tarjeta y Pin</p>
          </div>
        </div>
        <div class="security-card">
          <div class="security-img-wrap">
            <img src="/images/about-us-04.jpg" alt="Crosschex" />
          </div>
          <div class="security-body">
            <span class="security-brand">crosschex</span>
            <p class="security-desc">Versión gratuita local y cloud para reportes de control de accesos ANVIZ</p>
          </div>
        </div>
        <div class="security-card">
          <div class="security-img-wrap">
            <a href="https://zktecolatinoamerica.com/"><img src="/images/ZKTeco.png" alt="Controles de acceso" /></a>
          </div>
          <div class="security-body">
            <span class="security-brand">zkteco</span>
            <p class="security-desc">Controles de acceso, barras, detectores de metales</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .page-heading {
    background: linear-gradient(135deg, #323946 0%, #1e2530 100%);
    padding: 40px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: #EFBD1A;
    border-radius: 2px;
  }

  .page-heading h1 {
    color: #fff;
    font-size: 26px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    position: relative;
  }

  .intro-section {
    padding: 60px 0;
  }

  .intro-grid {
    display: flex;
    gap: 50px;
    align-items: center;
  }

  .intro-image {
    flex: 0 0 470px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .intro-image img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s;
  }

  .intro-image:hover img {
    transform: scale(1.03);
  }

  .intro-content h2 {
    color: #323946;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 20px;
    line-height: 1.4;
    position: relative;
    padding-bottom: 15px;
  }

  .intro-content h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 50px;
    height: 3px;
    background: #24A3D8;
    border-radius: 2px;
  }

  .intro-content p {
    font-size: 14px;
    line-height: 1.7;
    color: #666;
    margin-bottom: 20px;
  }

  .btn {
    display: inline-block;
    background-color: #24A3D8;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 12px 30px;
    border-radius: 4px;
    transition: 0.6s;
  }

  .btn:hover {
    background-color: #EFBD1A;
    color: #fff;
  }

  .dark-bg {
    background-color: #323946;
  }

  .section-title {
    color: #fff;
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 2px;
    padding: 40px 0 30px;
  }

  .banner-section {
    padding: 50px 0;
  }

  .banner-content {
    text-align: center;
  }

  .banner-content p {
    color: #fff;
    font-size: 16px;
    line-height: 1.6;
    max-width: 900px;
    margin: 0 auto 25px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .security-section {
    padding: 60px 0 70px;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  }

  .security-section .section-title {
    color: #323946;
    margin-bottom: 8px;
  }

  .security-subtitle {
    text-align: center;
    color: #888;
    font-size: 14px;
    margin-bottom: 40px;
    letter-spacing: 1px;
  }

  .security-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .security-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .security-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  }

  .security-img-wrap {
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    height: 180px;
    border-bottom: 1px solid #f0f0f0;
  }

  .security-img-wrap img {
    display: block;
    max-width: 85%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s;
  }

  .security-card:hover .security-img-wrap img {
    transform: scale(1.05);
  }

  .security-body {
    padding: 20px;
    text-align: center;
  }

  .security-desc {
    font-size: 13px;
    color: #888;
    line-height: 1.5;
    margin: 0;
  }

  .security-brand {
    display: block;
    color: #24A3D8;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    position: relative;
    padding-bottom: 10px;
  }

  .security-brand::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 30px;
    height: 2px;
    background: #EFBD1A;
    border-radius: 1px;
  }

  @media (max-width: 992px) {
    .security-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 992px) {
    .intro-grid {
      flex-direction: column;
    }

    .intro-image {
      flex: none;
      width: 100%;
      max-width: 500px;
    }
  }

  @media (max-width: 768px) {
    .page-heading {
      padding: 30px 0;
    }

    .page-heading h1 {
      font-size: 16px;
      letter-spacing: 2px;
    }

    .intro-section {
      padding: 40px 0;
    }

    .intro-content h2 {
      font-size: 16px;
    }

    .section-title {
      font-size: 20px;
    }

    .tech-grid {
      grid-template-columns: 1fr;
    }

    .security-grid {
      grid-template-columns: 1fr;
    }

    .security-img-wrap {
      height: 150px;
      padding: 16px;
    }
  }

  .brands-carousel-section {
    padding: 50px 0;
    background-color: #f8f9fa;
    overflow: hidden;
  }

  .brands-title {
    color: #323946 !important;
  }

  .marquee-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .marquee-wrapper::before,
  .marquee-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-wrapper::before {
    left: 0;
    background: linear-gradient(to right, #f8f9fa, transparent);
  }

  .marquee-wrapper::after {
    right: 0;
    background: linear-gradient(to left, #f8f9fa, transparent);
  }

  .marquee-track {
    display: flex;
    overflow: hidden;
  }

  .marquee-content {
    display: flex;
    flex-shrink: 0;
    animation: marquee 80s linear infinite;
  }

  .marquee-item {
    flex: 0 0 160px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 10px;
    padding: 10px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .marquee-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter 0.3s, opacity 0.3s;
  }

  .marquee-item:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  @media (max-width: 480px) {
    .page-heading h1 {
      font-size: 15px;
      letter-spacing: 1px;
    }

    .section-title {
      font-size: 17px;
    }

    .banner-content p {
      font-size: 13px;
    }
  }
</style>
