  <section class="tech-section dark-bg">
    <div class="container">
      <h2 class="tech-title-prs">TECNOLOGIAS DE ESCANEO</h2>
      <div class="tech-grid">
        <div class="tech-label">OMR</div>
        <div class="tech-info">
          <div class="tech-name"></div>
