<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .section {
    padding: 60px 0;
    text-align: center;
  }

  .section-light {
    background: #fff;
  }

  .section-dark {
    background: #323946;
    color: #f4f4f4;
  }

  .section-title {
    font-size: 28px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 40px;
    color: #323946;
  }

  .section-dark .section-title {
    color: #fff;
  }

  /* Hero Slider */
  .hero-slider {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
  }

  .slides {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: slideFade 12s infinite;
  }

  .slide-1 {
    background-image: url("/images/home-slide-1.jpg");
    animation-delay: 0s;
  }

  .slide-2 {
    background-image: url("/images/home-slider-1-slide-1.jpg");
    animation-delay: 6s;
  }

  @keyframes slideFade {
    0% {
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    45% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
  }

  .slide-content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: #fff;
    max-width: 800px;
    padding: 20px;
  }

  .slide-content h2 {
    font-size: 36px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .slide-content p {
    font-size: 18px;
    margin-bottom: 30px;
    color: #f4f4f4;
  }

  .btn-contacto {
    display: inline-block;
    background: #24a3d8;
    color: #fff;
    padding: 12px 30px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    transition: 0.3s;
  }

  .btn-contacto:hover {
    background: #efbd1a;
    color: #fff;
  }

  /* Columns 3 */
  .columns-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    text-align: left;
    margin-top: 30px;
  }

  .col h3 {
    font-size: 20px;
    font-weight: 700;
    color: #24a3d8;
    margin-bottom: 15px;
    text-transform: uppercase;
    text-align: center;
  }

  .col p {
    font-size: 14px;
    line-height: 1.8;
    color: #666;
    margin-bottom: 10px;
  }

  /* Capacidades */
  .capacidades-inner {
    display: flex;
    align-items: center;
    gap: 50px;
    text-align: left;
  }

  .capacidades-img {
    flex: 0 0 auto;
  }

  .capacidades-text {
    flex: 1;
  }

  .capacidades-text .section-title {
    text-align: left;
    color: #fff;
  }

  .capacidades-text ul {
    list-style: none;
    padding: 0;
  }

  .capacidades-text ul li {
    font-size: 16px;
    padding: 10px 0;
    color: #f4f4f4;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .capacidades-text ul li::before {
    content: "\f00c";
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    color: #efbd1a;
    margin-right: 12px;
  }

  /* Transformación */
  .section-transformacion p {
    font-size: 15px;
    line-height: 1.8;
    color: #666;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Testimonios */
  .testimonios-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    max-width: 900px;
    margin: 0 auto;
  }

  .testimonio-card {
    background: #f9f9f9;
    padding: 30px;
    border-radius: 8px;
    text-align: center;
  }

  .section-dark .testimonio-card {
    background: rgba(255, 255, 255, 0.08);
  }

  .testimonio-card img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 15px;
  }

  .testimonio-card h4 {
    font-size: 16px;
    font-weight: 700;
    color: #323946;
    margin-bottom: 5px;
  }

  .section-dark .testimonio-card h4 {
    color: #fff;
  }

  .testimonio-card p {
    font-size: 13px;
    color: #24a3d8;
    margin-bottom: 15px;
  }

  .testimonio-card blockquote {
    font-size: 14px;
    font-style: italic;
    color: #666;
    line-height: 1.6;
  }

  .section-dark .testimonio-card blockquote {
    color: #ccc;
  }

  /* Client Logos */
  .client-logos {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .logo-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 40px 60px;
    margin-bottom: 30px;
  }

  .logo-row img {
    max-width: 180px;
    max-height: 100px;
    object-fit: contain;
  }

  .logo-category {
    margin-bottom: 40px;
  }

  /* Logo Grid v2 - Versión A: Excel-like uniforme */
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px 20px;
    align-items: center;
    justify-items: center;
  }

  .logo-cell {
    width: 100%;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 8px;
    box-sizing: border-box;
    background: transparent;
  }

  .logo-cell img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    filter: grayscale(20%);
    opacity: 0.92;
    transition: filter 0.35s ease, opacity 0.35s ease, transform 0.35s ease;
  }

  .logo-cell:hover img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.06);
  }

  /* USAC: caption bajo el logo */
  .logo-cell--caption {
    flex-direction: column;
    gap: 6px;
    height: 140px;
  }

  /* Universities grid: todas las celdas con caption, misma altura */
  .logo-grid--universities .logo-cell {
    height: 140px;
    flex-direction: column;
    gap: 6px;
  }

  .logo-grid--universities .logo-cell img {
    max-height: 85px;
  }

  .logo-caption {
    font-size: 10px;
    color: #555;
    font-weight: 600;
